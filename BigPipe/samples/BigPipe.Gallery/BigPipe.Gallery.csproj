<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationIcon>Assets\bigpipe.ico</ApplicationIcon>
    <Description>BigPipe Gallery: runnable use cases with sample code. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="TorchSharp-cpu" Version="0.107.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\dotnet\src\BigPipe.Client\BigPipe.Client.csproj" />
    <ProjectReference Include="..\..\sdk\dotnet\src\BigPipe.Streams\BigPipe.Streams.csproj" />
    <ProjectReference Include="..\..\sdk\dotnet\src\BigPipe.Analytics.Scripting\BigPipe.Analytics.Scripting.csproj" />
    <ProjectReference Include="..\..\sdk\dotnet\src\BigPipe.Analytics.ML\BigPipe.Analytics.ML.csproj" />
    <ProjectReference Include="..\..\sdk\dotnet\src\BigPipe.Analytics.Torch\BigPipe.Analytics.Torch.csproj" />
    <ProjectReference Include="..\..\sdk\dotnet\src\BigPipe.Analytics.Gravicode\BigPipe.Analytics.Gravicode.csproj" />
  </ItemGroup>
</Project>
