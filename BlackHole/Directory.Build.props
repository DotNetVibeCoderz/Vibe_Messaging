<Project>

  <!-- ================================================================
       BlackHole Messaging
       Built by Gravicode Studios, led by Kang Fadhil.
       https://github.com/DotNetVibeCoderz/Vibe_Messaging/tree/main/BlackHole
       ================================================================ -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1701</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Product>BlackHole Messaging</Product>
    <Company>Gravicode Studios</Company>
    <Authors>Gravicode Studios</Authors>
    <Copyright>Copyright (c) Gravicode Studios. Led by Kang Fadhil.</Copyright>
    <VersionPrefix>3.1.0</VersionPrefix>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Messaging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
