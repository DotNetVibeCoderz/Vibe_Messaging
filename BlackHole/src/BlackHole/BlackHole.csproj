<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BlackHole</RootNamespace>
    <AssemblyName>BlackHole</AssemblyName>
    <!-- The shared-memory ring maps a segment and indexes it directly; that is the whole point
         of shared memory, and it is confined to Transport/SharedMemoryRing.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comment on public member: the codebase documents the surface that matters. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- ============================ NuGet package ============================ -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- The id "BlackHole" is already taken on nuget.org, so the package ships
         as BlackHole.Messaging. Assembly and namespaces stay BlackHole.*. -->
    <PackageId>BlackHole.Messaging</PackageId>
    <Title>BlackHole Messaging</Title>
    <Description>High-performance, allocation-conscious messaging for .NET 10. A length-prefixed binary protocol with RPC, Pub/Sub, Streaming and Batching, built on System.IO.Pipelines, over TCP, Unix domain sockets, named pipes or shared memory. Built by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>messaging;rpc;pubsub;tcp;ipc;shared-memory;unix-socket;named-pipe;streaming;batching;pipelines;high-performance;iot;sockets;binary-protocol</PackageTags>
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Messaging/tree/main/BlackHole</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Messaging/tree/main/BlackHole</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v3.1.0 - Adds three same-machine transports alongside TCP: Unix domain sockets, named pipes, and shared memory. All four carry the same wire format through the same patterns, so switching is one line. Shared memory measures 3.2us RPC round trips, 18x faster than loopback TCP. Also adds RpcServer.RegisterDetached for handlers that call back on their own connection, and a configure callback on BlackHoleClient.ConnectAsync so handlers are registered before the first message arrives. No breaking changes.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlackHole.Tests" />
    <InternalsVisibleTo Include="BlackHole.Benchmarks" />
  </ItemGroup>

</Project>
